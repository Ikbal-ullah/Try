# Copy this file to ".env" and fill in your key.  The real .env is gitignored.
# These variables are read ONLY by the server (server/index.js).
# They are never sent to the browser - do not rename them with a VITE_ prefix.

# Any OpenAI-compatible chat-completions endpoint works. Pick ONE block.

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.5-flash-lite,gemini-2.5-flash
LLM_API_KEY=

# --- Groq (free tier: https://console.groq.com/keys) ---
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=

# --- OpenAI (paid: the account needs credit) ---
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.4-mini,gpt-4.1-mini
# LLM_API_KEY=
# LLM_TEMPERATURE=off   # newer OpenAI models only accept their default temperature

# --- Ollama, running locally, no key needed ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# LLM_MODEL can list a fallback after a comma: the automatic retry uses it
# when the first model is overloaded or returns unusable output.
# Model names change often - if you get a "model not found" error,
# check your provider's current model list and update LLM_MODEL.

# Optional
# PORT=3001
# LLM_TIMEOUT_MS=30000

# Production settings (all optional; these are the defaults)
# TRUST_PROXY=0                    # proxies in front of the server: 1 behind a load balancer (Render, AWS)
# RATE_LIMIT_PER_MINUTE=10         # generations allowed per visitor per minute
# RATE_LIMIT_PER_DAY=100           # generations allowed per visitor per day
# MAX_CONCURRENT_GENERATIONS=8     # model calls allowed at once across all visitors
