{
  "name": "study-assistant",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Paste notes or a topic, get AI-generated flashcards and a quiz you can actually study with.",
  "scripts": {
    "start": "concurrently -k -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js --dev",
    "dev:web": "vite",
    "build": "vite build",
    "serve": "node server/index.js",
    "test": "vitest run"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.3"
  }
}
